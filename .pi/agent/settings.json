  "powerline": {
    "preset": "default",
    "customItems": [
      {
        "id": "codex",
        "statusKey": "codex-usage",
        "position": "right",
        "prefix": "codex",
        "color": "warning",
        "hideWhenMissing": true
      },
      {
        "id": "glm",
        "statusKey": "glm-usage",
        "position": "right",
        "prefix": "GLM",
        "color": "accent",
        "hideWhenMissing": true
      },
      {
        "id": "openrouter-credits",
        "statusKey": "openrouter-credits",
        "position": "right",
        "prefix": "$",
        "color": "info",
        "hideWhenMissing": true
      }
    ]
  },
  "enableSkillCommands": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384
  },
  "defaultThinkingLevel": "medium",
  "transport": "websocket-cached",
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 500,
    "provider": {
      "timeoutMs": 120000,
      "maxRetries": 0
    }
  },
  "httpIdleTimeoutMs": 120000,
  "extensions": [
    "!extensions/notion/**",
    "!extensions/cline/**",
    "!extensions/prompt-refiner/**",
    "!extensions/deepseek-web/**",
    "!extensions/qwen-web/**",
    "!extensions/hermes-fallback.disabled/**",
    "!extensions/nvidia-auto.disabled/**",
    "!extensions/nvidia-free.disabled/**"
  ],
  "theme": "dark",
  "terminal": {
    "showTerminalProgress": true
  },
  "steeringMode": "all",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "defaultProvider": "bansos",
  "defaultModel": "mimo-v2.5-free"
